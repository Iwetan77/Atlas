# Copy to .env for local dev. EAS builds take these from eas.json.
# Optional override; the real client ID is the default in src/config.ts
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_ENGINE_URL=https://justatlas.xyz
# Hosted browser app where Atlas Links open.
EXPO_PUBLIC_WEB_URL=https://justatlas.xyz

# Public HTTPS link to the published Android APK; not a secret.
EXPO_PUBLIC_ANDROID_APK_URL=https://justatlas.xyz/download/android
