# Copy to .env for local dev. EAS builds take these from eas.json.
# Optional override; the real client ID is the default in src/config.ts
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_ENGINE_URL=https://atlas-engine-djed.onrender.com
# Hosted browser app where Atlas Links open.
EXPO_PUBLIC_WEB_URL=https://atlas-engine-djed.onrender.com

# Public HTTPS link to the published Android APK. Leave empty until available.
EXPO_PUBLIC_ANDROID_APK_URL=
